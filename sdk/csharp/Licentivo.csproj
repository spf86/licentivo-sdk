<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PackageId>Licentivo.SDK</PackageId><Version>0.11.1</Version><Description>Licentivo software licensing client</Description><PackageReadmeFile>README.md</PackageReadmeFile></PropertyGroup>
  <PropertyGroup><PackageLicenseExpression>MIT</PackageLicenseExpression><RepositoryUrl>https://github.com/spf86/licentivo-sdk</RepositoryUrl><RepositoryType>git</RepositoryType><PackageProjectUrl>https://www.licentivo.com</PackageProjectUrl><Authors>spf86</Authors></PropertyGroup>
  <PropertyGroup><PackageTags>licensing;sdk;activation;offline;heartbeat;entitlements;metering</PackageTags><Description>Licentivo .NET client for license activation, private device credentials, pinned signature verification, feature access, policy heartbeats, offline grants, floating seats and metered workflows.</Description></PropertyGroup>
  <ItemGroup><None Update="README.md" Pack="true" PackagePath="/" /><None Include="../LICENSE" Pack="true" PackagePath="/" /><None Include="../NOTICE" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" /></ItemGroup>
  <ItemGroup><Compile Remove="demo/**/*.cs;winforms/**/*.cs;quickstart/**/*.cs" /></ItemGroup>
</Project>
